# ============================================================
# .env.example — Copia este fichero como .env y rellena los valores
# NUNCA commitees el fichero .env (está en .gitignore)
# ============================================================

# ─── Keycloak ────────────────────────────────────────────────
KEYCLOAK_URL=https://manuhd.duckdns.org/auth
KEYCLOAK_REALM=atg
KEYCLOAK_CLIENT_ID=atg-service-account
KEYCLOAK_CLIENT_SECRET=
SERVICE_ACCOUNT_USER=claude-bot
SERVICE_ACCOUNT_PASS=

# ─── API ─────────────────────────────────────────────────────
API_BASE_URL=https://manuhd.duckdns.org

# ─── Claude Code ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Cron (formato crontab estándar) ─────────────────────────
# 0 3 * * *   → cada día a las 3 AM
# 0 */6 * * * → cada 6 horas
CRON_SCHEDULE=0 3 * * *
