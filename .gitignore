# ─── Secretos y configuración local ──────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Artefactos de compilación ────────────────────────────────────────────────
backend/*/target/
backend/*/app.jar
frontend/dist/
frontend/.angular/
frontend/node_modules/

# ─── Claude Code ──────────────────────────────────────────────────────────────
.claude/

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ─── SO ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Maven wrapper binario (se descarga automáticamente) ──────────────────────
.mvn/wrapper/maven-wrapper.jar

# ─── Scripts de automatización ────────────────────────────────────────────────
scripts/.env
/tmp/atg_*

# Almacenamiento de la aplicación en tiempo de ejecución (PDFs de solicitudes,
# plantillas subidas...). En producción vive en volúmenes Docker, nunca en el
# repo: no debe versionarse.
backend/*/storage/
